node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Gotowa rolka i opis do niej (output/reel.mp4, output/opis.txt)
output

# Regenerated by the analysis pipeline on every run
video-frames
video-frames-detail

# FFmpeg-normalized clips, rebuilt per set from public/media/<zestaw>
public/processed

# Wejściowe zdjęcia i filmy — materiał per realizacja, trzymany
# lokalnie, nie synchronizowany przez Git
public/media/

# Podkłady muzyczne — licencjonowane pliki audio, ciężkie i wymieniane
# niezależnie od kodu. Brak folderu = rolka bez podkładu.
public/music/

# Pliki transformacji vidstab (kasowane po normalizacji)
*.trf

# Cache analizy per zestaw — odtwarzalny, ale kosztowny; lokalnie
work/
